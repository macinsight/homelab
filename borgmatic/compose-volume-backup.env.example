# Local Borg repository. Create and initialize this repository separately.
LOCAL_BORG_REPOSITORY=/srv/borg/local-compose-volumes

# Hetzner Storage Box Borg repository. Initialize it separately with Borg 2.
REMOTE_BORG_REPOSITORY=ssh://storagebox-user@storagebox-host:23/./borg/server-name

# Borg uses these variables for the source (local) repository. Use a secure
# secret manager or an encrypted file for production credentials.
# BORG_PASSPHRASE=replace-me

# Set this when the remote repository has a different passphrase.
# BORG_OTHER_REPO_PASSPHRASE=replace-me

# The restore script reads the remote repository directly. Set this when its
# passphrase differs from the local repository's BORG_PASSPHRASE.
# REMOTE_BORG_PASSPHRASE=replace-me

# Use this instead of REMOTE_BORG_PASSPHRASE when a secret manager supplies
# the remote repository passphrase.
# REMOTE_BORG_PASSCOMMAND='secret-tool lookup service borg-storagebox'

# Point Borg at the dedicated Storage Box SSH key and pinned host keys.
# BORG_RSH='ssh -i /root/.config/borg/storagebox_ed25519 -o UserKnownHostsFile=/root/.config/borg/known_hosts'

# Defaults to this repository's root. Set this only when Compose projects live
# elsewhere.
# BACKUP_SOURCE_ROOT=/srv/homelab

# Git source and checkout used by restore-compose-volumes.sh. The checkout
# must be clean when it already exists; Git will never overwrite local edits.
COMPOSE_REPOSITORY=git@github.com:macinsight/homelab.git
COMPOSE_CHECKOUT=/srv/homelab
# COMPOSE_REF=main

# The image must provide tar. It is pulled automatically if absent.
# VOLUME_EXPORT_IMAGE=docker.io/library/alpine:3.21
